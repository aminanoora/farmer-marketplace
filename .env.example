# ─── Server ─────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB
# Local: mongodb://localhost:27017/krishi_market
# Atlas (production): mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/krishi_market?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/krishi_market

# JWT Authentication
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-64-char-hex-secret-here
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000

# Backend origin used by Next.js rewrites (proxies /api and /uploads to the server)
# Required in production (e.g. https://your-api.railway.app) — defaults to http://localhost:5000
BACKEND_URL=http://localhost:5000

# File Uploads — stored on Vercel Blob (UPLOAD_DIR is no longer used)
# Create a Blob store in the Vercel project and it injects BLOB_READ_WRITE_TOKEN.
# For local dev, add the same token here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
MAX_FILE_SIZE=4194304  # 4MB per file (Vercel serverless body limit is 4.5MB)

# ─── Client (Next.js) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email (Resend)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY=
